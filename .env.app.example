# Copy to .env.app and fill in — loaded by both the FastAPI backend
# (backend/main.py) and the legacy Streamlit client (app.py).
# On Streamlit Community Cloud, use .streamlit/secrets.toml instead; it
# takes priority over these values when both are present.

ALBERT_API_KEY=

# JWT signing secret for the FastAPI backend (React front-end auth). MUST be a
# long random value in production — anyone who knows it can mint valid tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=
# Optional: access-token lifetime in minutes (default 720 = 12h).
# JWT_EXPIRE_MIN=720

# User accounts are always required to use the app — login + self-service
# registration, backed by a local SQLite database (auth_data/viromechat.db,
# created automatically, gitignored). No external identity provider. On first
# run, any pre-existing auth_data/.streamlit_auth.yaml accounts and
# logs/user_histories/*.json chat history are imported into the database.

# Optional shared invite code gating account creation: if set, a new user
# must enter this exact code (in addition to email/password/captcha) to
# register. Leave empty/omit to keep registration open to anyone.
# REGISTRATION_CODE=

# Comma-separated list of emails granted the 'admin' role at registration —
# used to bootstrap the first admin. Admins then manage every user's role
# (user / dev / admin) from the Administration page. Applied both to new
# registrations and to accounts imported on first run. Leave empty for no
# admins. Example: ADMIN_EMAILS=alice@lab.fr,bob@univ.fr
# ADMIN_EMAILS=
