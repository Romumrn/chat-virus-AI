.DS_Store
logs/*
# Only the top-level datasets directory — anchored + trailing slash so this
# does NOT case-insensitively match source files like DatasetsInfo.tsx
# (git has core.ignorecase=true on macOS, where a bare "data*" would).
/data/
**/__pycache__/

# Front-end: dependencies and build output are regenerated by npm — never commit.
frontend/node_modules/
frontend/dist/

.pytest_cache/
.claude/
# Secrets — see .env.app.example / .env.mcp.example for the expected keys
.env
.env.app
.env.mcp
.streamlit/secrets.toml

# Local user accounts (usernames, bcrypt-hashed passwords, cookie key):
# keep the directory tracked (so the Docker bind-mount has a host dir owned
# by the host user before first run) but never commit the credentials file.
auth_data/*
!auth_data/.gitkeep
test_neo4j.ipynb
test_S3MCP.ipynb
.gitignore
